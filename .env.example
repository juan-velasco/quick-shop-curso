# Copiar a .env y ajustar. Nunca versionar .env.

# PostgreSQL
POSTGRES_USER=quickshop
POSTGRES_PASSWORD=change_me
POSTGRES_DB=quickshop
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://quickshop:change_me@db:5432/quickshop
SECRET_KEY=change_me_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
SEED_PRODUCTS_FILE=/app/docs/products-images.json
SEED_ADMIN_EMAIL=admin@quickshop.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_CLIENT1_EMAIL=cliente1@quickshop.com
SEED_CLIENT2_EMAIL=cliente2@quickshop.com
SEED_CLIENT_PASSWORD=Cliente1234!

# Frontend (VITE_API_URL se fija en build; debe ser la URL del backend vista desde el navegador)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
